{
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {"source": "/index", "destination": "/", "permanent": true},
    {"source": "/index.html", "destination": "/", "permanent": true}
  ],
  "outputDirectory": "src/public",
  "buildCommand": null,
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}
    ]}
  ],
  "rewrites": [
    {"source": "/api/:action(session|login|register|verify|logout|workspace|runtime)", "destination": "/api/preview?action=:action"}
  ]
}
