{
  "framework": null,
  "functions": {"api/preview.js":{"includeFiles":"node_modules/node-unrar-js/**/*","maxDuration":60},"api/github-hook.mjs":{"maxDuration":60}},
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "outputDirectory": "src/public",
  "buildCommand": null,
  "crons": [{"path":"/api/sync-status","schedule":"0 6 * * *"}],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.discordapp.com data: blob:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:action(session|login|register|verify|logout|workspace|runtime|status|reviews|admin|billing|payments-ipn|archive|github-login|github-callback|github|discord-login|discord-callback|sync-status)",
      "destination": "/api/preview?action=:action"
    }
  ]
}
