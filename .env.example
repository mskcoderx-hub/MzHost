PORT=4181
MZHOST_STORAGE=sqlite
LOCAL_TEST_ACCOUNT=false
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/mzhost
MONGODB_DB=mzhost_preview
APP_ORIGIN=https://mzhost.vercel.app
RESEND_API_KEY=
MAIL_FROM="MzHost <verify@mskhub.store>"
MAIL_HOURLY_LIMIT=100
# Optional random secret for stable anonymous account IDs in audit events.
AUDIT_KEY=
DISCORD_ACCOUNTS_WEBHOOK=
DISCORD_SECURITY_WEBHOOK=
DISCORD_OPERATIONS_WEBHOOK=
DISCORD_WORKSPACE_WEBHOOK=
VPS_WORKER_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
CRON_SECRET=

# Optional exact callback registered in Discord
DISCORD_REDIRECT_URI=
# Optional hashed admin record from scripts/configure-admin.ps1
ADMIN_CREDENTIALS=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
